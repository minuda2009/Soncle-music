<Page
    x:Class="Soncle.Droid.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI"
    Background="{ThemeResource BackgroundBrush}">

    <!-- The adaptive shell (docs/DESIGN.md §3.1): the four destinations in a bottom bar on a phone,
         in a rail when the window is at least 600 effective px wide (MainPage.xaml.cs switches it),
         and the player bar (§4.1) above the bottom bar. -->
    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The rail. On narrow windows its pane is hidden and only the content shows. Items are
             text-only until Soncle.Design brings the Material Symbols font (README, known gaps). -->
        <NavigationView x:Name="Rail"
                        Grid.Row="0"
                        PaneDisplayMode="Left"
                        OpenPaneLength="180"
                        IsPaneVisible="False"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnRailSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" IsSelected="True" />
                <NavigationViewItem Content="Library" />
                <NavigationViewItem Content="Sound" />
                <NavigationViewItem Content="Settings" />
            </NavigationView.MenuItems>

            <!-- Pages arrive with Soncle.App; the shell shows one placeholder per destination. -->
            <Grid Background="{ThemeResource BackgroundBrush}" Padding="24">
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <TextBlock x:Name="DestinationTitle"
                               Text="Home"
                               Style="{StaticResource HeadlineMedium}" />
                    <TextBlock Text="The pages arrive with Soncle.App. This Android build is the shell and a test sound."
                               TextWrapping="WrapWholeWords"
                               Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <!-- Settings only: the docs/DESIGN.md §7.2 start-up measurement, quietly. -->
                    <TextBlock x:Name="FirstFrameLine"
                               Visibility="Collapsed"
                               Margin="0,16,0,0"
                               Style="{StaticResource BodySmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
            </Grid>
        </NavigationView>

        <!-- Player bar: the empty state is a message, never a blank square with 0:00 / 0:00
             (docs/DESIGN.md §4.1). The tinted square appears only once the test sound is loaded. -->
        <Grid Grid.Row="1"
              Margin="8,4"
              Padding="12,8"
              CornerRadius="16"
              ColumnSpacing="12"
              Background="{ThemeResource SurfaceVariantBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="NowArt"
                    Width="48" Height="48"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    Background="{ThemeResource PrimaryBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="NowTitle"
                           Text="Nothing playing"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource TitleSmall}" />
                <TextBlock x:Name="NowDetail"
                           Text="Your library is empty in this preview build. Test sound plays a short built-in clip."
                           TextWrapping="WrapWholeWords"
                           MaxLines="2"
                           Style="{StaticResource BodySmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </StackPanel>
            <Button x:Name="PlayButton"
                    Grid.Column="2"
                    Content="Test sound"
                    Click="OnPlayClick"
                    Style="{StaticResource FilledButtonStyle}" />
        </Grid>

        <!-- The bottom bar (phones). Hidden when the rail shows. -->
        <utu:TabBar x:Name="BottomBar"
                    Grid.Row="2"
                    SelectedIndex="0"
                    Style="{StaticResource BottomTabBarStyle}">
            <utu:TabBar.Items>
                <utu:TabBarItem Content="Home" />
                <utu:TabBarItem Content="Library" />
                <utu:TabBarItem Content="Sound" />
                <utu:TabBarItem Content="Settings" />
            </utu:TabBar.Items>
        </utu:TabBar>
    </Grid>
</Page>
