<Page
    x:Class="Soncle.Droid.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI"
    Background="{ThemeResource BackgroundBrush}">

    <!-- The adaptive shell (docs/DESIGN.md §3.1): the four destinations in a bottom bar on a phone,
         in a rail when the window is at least 600 effective px wide (MainPage.xaml.cs switches it),
         the search box, and the player bar (§4.1) above the bottom bar. -->
    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search in the title area (docs/DESIGN.md §3.1: search at the top of Home on a phone).
             Enter searches; a pick plays it with the results as the queue. -->
        <AutoSuggestBox x:Name="SearchBox"
                        Grid.Row="0"
                        Margin="12,8"
                        PlaceholderText="Search songs"
                        AutomationProperties.Name="Search songs"
                        TextChanged="OnSearchTextChanged"
                        QuerySubmitted="OnSearchSubmitted">
            <AutoSuggestBox.QueryIcon>
                <SymbolIcon Symbol="Find" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <!-- The rail. On narrow windows its pane is hidden and only the content shows. Items are
             text-only until Soncle.Design brings the Material Symbols font (README, known gaps). -->
        <NavigationView x:Name="Rail"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="180"
                        IsPaneVisible="False"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnRailSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" IsSelected="True" />
                <NavigationViewItem Content="Library" />
                <NavigationViewItem Content="Sound" />
                <NavigationViewItem Content="Settings" />
            </NavigationView.MenuItems>

            <Grid Background="{ThemeResource BackgroundBrush}">
                <!-- One placeholder per destination; search results replace it until another
                     destination is picked. -->
                <StackPanel x:Name="Placeholder" Margin="24" VerticalAlignment="Center" Spacing="8">
                    <TextBlock x:Name="DestinationTitle"
                               Text="Home"
                               Style="{StaticResource HeadlineMedium}" />
                    <TextBlock Text="Search for a song above and pick it to play. Pages arrive with Soncle.App."
                               TextWrapping="WrapWholeWords"
                               Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <!-- Settings only: the docs/DESIGN.md §7.2 start-up measurement, quietly. -->
                    <TextBlock x:Name="FirstFrameLine"
                               Visibility="Collapsed"
                               Margin="0,16,0,0"
                               Style="{StaticResource BodySmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>

                <!-- Search results. -->
                <Grid x:Name="ResultsPanel" Visibility="Collapsed" Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressRing x:Name="SearchSpinner"
                                  Grid.Row="0"
                                  Width="24" Height="24"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Left" />
                    <ListView x:Name="ResultsList"
                              Grid.Row="1"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnResultClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Artwork arrives with Soncle.Design; the tinted square keeps the row's shape. -->
                                    <Border Width="48" Height="48"
                                            CornerRadius="8"
                                            Background="{ThemeResource SurfaceVariantBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource TitleSmall}" />
                                        <TextBlock Text="{Binding Artists}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource BodySmall}"
                                                   Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="SearchMessage"
                               Grid.Row="2"
                               TextWrapping="WrapWholeWords"
                               Style="{StaticResource BodySmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Player bar (docs/DESIGN.md §4.1): the empty state is a message, never a blank square with
             0:00 / 0:00. Play/pause, previous/next and a seek bar work on the current song. -->
        <Grid Grid.Row="2"
              Margin="8,4"
              Padding="12,8"
              CornerRadius="16"
              ColumnSpacing="12"
              Background="{ThemeResource SurfaceVariantBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="NowArt"
                    Width="48" Height="48"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    Background="{ThemeResource PrimaryBrush}">
                <Image x:Name="NowArtImage" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="NowTitle"
                           Text="Nothing playing"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource TitleSmall}" />
                <TextBlock x:Name="NowDetail"
                           Text="Search for a song above, then pick it to play."
                           TextWrapping="WrapWholeWords"
                           MaxLines="2"
                           Style="{StaticResource BodySmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                <Slider x:Name="SeekBar"
                        Margin="0,4,0,0"
                        Minimum="0"
                        Maximum="1"
                        Visibility="Collapsed"
                        ValueChanged="OnSeekValueChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ProgressRing x:Name="BarSpinner" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <Button x:Name="PrevButton" Content="Prev" Click="OnPrevClick" IsEnabled="False" />
                <Button x:Name="PlayButton" Content="Play" Click="OnPlayPauseClick" IsEnabled="False"
                        Style="{StaticResource FilledButtonStyle}" />
                <Button x:Name="NextButton" Content="Next" Click="OnNextClick" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- The bottom bar (phones). Hidden when the rail shows. -->
        <utu:TabBar x:Name="BottomBar"
                    Grid.Row="3"
                    SelectedIndex="0"
                    Style="{StaticResource BottomTabBarStyle}">
            <utu:TabBar.Items>
                <utu:TabBarItem Content="Home" />
                <utu:TabBarItem Content="Library" />
                <utu:TabBarItem Content="Sound" />
                <utu:TabBarItem Content="Settings" />
            </utu:TabBar.Items>
        </utu:TabBar>
    </Grid>
</Page>
