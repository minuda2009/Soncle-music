<Page
    x:Class="Soncle.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <!-- Mica shows through the title bar and the rail; the page keeps its own Material surface
             (docs/DESIGN.md §4.5). -->
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- The 48 px custom title bar (docs/WINUI_PLAN.md §2.5). -->
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <!-- The player bar (docs/DESIGN.md §4.1). -->
            <RowDefinition Height="88" />
        </Grid.RowDefinitions>

        <!-- Title bar: WindowChrome makes this the drag region and leaves pass-through holes over
             the back button and the search box; the system caption buttons sit on the right. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" Padding="8,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    Width="36" Height="36" Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Back (Alt+Left)"
                    AutomationProperties.Name="Back"
                    Click="OnBackClick">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <TextBlock Grid.Column="1"
                       Text="Soncle Preview"
                       VerticalAlignment="Center"
                       Style="{StaticResource TitleSmall}" />
            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="2"
                            Width="420"
                            Margin="16,0"
                            VerticalAlignment="Center"
                            PlaceholderText="Search songs, albums, artists (Ctrl+K)"
                            AutomationProperties.Name="Search"
                            IsEnabled="False"
                            QuerySubmitted="OnSearchSubmitted">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </Grid>

        <!-- The rail: the four destinations (docs/DESIGN.md §3.1). -->
        <NavigationView x:Name="Rail"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnDestinationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Library" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Sound" Tag="sound">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Background="{ThemeResource BackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- First-run notice (kept from the JS app): shown until it is closed once. -->
                <InfoBar x:Name="Notice"
                         Margin="24,12,24,0"
                         IsOpen="False"
                         Severity="Informational"
                         Title="Welcome to Soncle"
                         Message="This is an unofficial hobby project. It can’t show YouTube’s ads, so artists aren’t paid through it."
                         Closed="OnNoticeClosed" />
                <ContentControl x:Name="PageHost"
                                Grid.Row="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False" />
            </Grid>
        </NavigationView>

        <!-- Now Playing covers the rail and the pages; the player bar stays below it. -->
        <Grid x:Name="NowPlayingHost" Grid.Row="1" Visibility="Collapsed" />

        <!-- Player bar: the empty state is a message, never a blank square with 0:00 / 0:00
             (docs/DESIGN.md §4.1). -->
        <Grid x:Name="EmptyBar"
              Grid.Row="2"
              Background="{ThemeResource SurfaceVariantBrush}"
              Padding="16,0"
              ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56"
                    CornerRadius="8"
                    Background="{ThemeResource PrimaryBrush}">
                <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource OnPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Nothing playing" Style="{StaticResource TitleSmall}" />
                <TextBlock Text="Pick something from Home, or search at the top."
                           Style="{StaticResource BodySmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </StackPanel>
        </Grid>

        <!-- Now playing: artwork, title + artists, the transport group and the seek bar, then the
             grouped right-hand controls (DESIGN.md §4.1). -->
        <Grid x:Name="NowPlayingBar"
              Grid.Row="2"
              Visibility="Collapsed"
              Background="{ThemeResource SurfaceVariantBrush}"
              Padding="16,0"
              ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="BarSong" ColumnSpacing="12" Background="Transparent" Tapped="OnBarSongTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Background="{ThemeResource PrimaryBrush}">
                    <Image x:Name="BarArtwork" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="BarTitle"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource TitleSmall}" />
                    <TextBlock x:Name="BarSubtitle"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource BodySmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <TextBlock x:Name="BarError"
                               Visibility="Collapsed"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource BodySmall}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button x:Name="ShuffleButton"
                            Width="40" Height="40" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Shuffle (S)"
                            AutomationProperties.Name="Shuffle"
                            Click="OnShuffleClick">
                        <FontIcon x:Name="ShuffleGlyph" Glyph="&#xE8B1;" FontSize="16" />
                    </Button>
                    <Button x:Name="PrevButton"
                            Width="40" Height="40" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Previous (Ctrl+Left)"
                            AutomationProperties.Name="Previous"
                            Click="OnPrevClick">
                        <FontIcon Glyph="&#xE892;" FontSize="16" />
                    </Button>
                    <Grid Width="40" Height="40">
                        <Button x:Name="PlayButton"
                                Width="40" Height="40" Padding="0"
                                CornerRadius="20"
                                Style="{StaticResource FilledButtonStyle}"
                                ToolTipService.ToolTip="Play (Space)"
                                AutomationProperties.Name="Play"
                                Click="OnPlayClick">
                            <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="16" />
                        </Button>
                        <ProgressRing x:Name="BarProgress"
                                      Width="40" Height="40"
                                      IsActive="False"
                                      IsHitTestVisible="False"
                                      Visibility="Collapsed" />
                    </Grid>
                    <Button x:Name="NextButton"
                            Width="40" Height="40" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Next (Ctrl+Right)"
                            AutomationProperties.Name="Next"
                            Click="OnNextClick">
                        <FontIcon Glyph="&#xE893;" FontSize="16" />
                    </Button>
                    <Button x:Name="RepeatButton"
                            Width="40" Height="40" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Repeat (R)"
                            AutomationProperties.Name="Repeat"
                            Click="OnRepeatClick">
                        <FontIcon x:Name="RepeatGlyph" Glyph="&#xE8EE;" FontSize="16" />
                    </Button>
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BarPosition"
                               Text="0:00"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodySmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    <Slider x:Name="SeekBar"
                            Grid.Column="1"
                            Minimum="0" Maximum="1" StepFrequency="1"
                            IsThumbToolTipEnabled="False"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Seek"
                            ValueChanged="OnSeekValueChanged" />
                    <TextBlock x:Name="BarDuration"
                               Grid.Column="2"
                               Text="0:00"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodySmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="4">
                <Button x:Name="LyricsButton"
                        Width="40" Height="40" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Lyrics (L)"
                        AutomationProperties.Name="Lyrics"
                        Click="OnLyricsClick">
                    <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                </Button>
                <Button x:Name="QueueButton"
                        Width="40" Height="40" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Queue (Q)"
                        AutomationProperties.Name="Queue"
                        Click="OnQueueClick">
                    <FontIcon Glyph="&#xE90B;" FontSize="16" />
                </Button>
                <Button x:Name="MuteButton"
                        Width="40" Height="40" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Mute (M)"
                        AutomationProperties.Name="Mute"
                        Click="OnMuteClick">
                    <FontIcon x:Name="VolumeGlyph" Glyph="&#xE767;" FontSize="16" />
                </Button>
                <Slider x:Name="VolumeSlider"
                        Width="110"
                        Minimum="0" Maximum="100" StepFrequency="1" Value="100"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Volume"
                        ValueChanged="OnVolumeChanged" />
                <Button x:Name="ExpandButton"
                        Width="40" Height="40" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Now Playing (F)"
                        AutomationProperties.Name="Now Playing"
                        Click="OnExpandClick">
                    <FontIcon x:Name="ExpandGlyph" Glyph="&#xE70E;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- The hidden BotGuard page lives here (Playback/WebViewBotGuardPage.cs): 1x1, invisible,
             never hit-tested; empty unless a PO token is minted. -->
        <Grid x:Name="BotGuardHost"
              Grid.RowSpan="3"
              Width="1"
              Height="1"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Opacity="0"
              IsHitTestVisible="False" />
    </Grid>
</Page>
