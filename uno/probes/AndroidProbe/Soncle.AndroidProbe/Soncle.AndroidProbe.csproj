<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Soncle.AndroidProbe</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.minuda2009.soncle.unoprobe</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Soncle.AndroidProbe</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Soncle.AndroidProbe powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Toolkit;
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <!-- Same floor as the Capacitor app (mobile/android/variables.gradle). -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

</Project>
