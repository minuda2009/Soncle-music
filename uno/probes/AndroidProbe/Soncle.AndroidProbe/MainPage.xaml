<Page x:Class="Soncle.AndroidProbe.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Soncle.AndroidProbe"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <!-- The smallest Soncle-shaped screen: a top bar, a long virtualised song list,
       the player bar and the four destinations (docs/DESIGN.md §3). -->
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Home" Margin="20,16,20,8"
               Style="{StaticResource HeadlineMedium}" />

    <ListView x:Name="Songs" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
              ItemClick="OnSongClick">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:Song">
          <Grid Padding="16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="48" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="8"
                    Background="{x:Bind Tint}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyLarge}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind Artist}" Style="{StaticResource BodyMedium}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- player bar -->
    <Grid Grid.Row="2" Margin="8,4" Padding="8" CornerRadius="16" ColumnSpacing="12"
          Background="{ThemeResource SurfaceVariantBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border x:Name="NowArt" Width="48" Height="48" CornerRadius="8"
              Background="{ThemeResource PrimaryBrush}" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="NowTitle" Text="Nothing playing" Style="{StaticResource TitleSmall}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Startup" Style="{StaticResource BodySmall}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}" />
      </StackPanel>
      <Button Grid.Column="2" Content="Play" Style="{StaticResource FilledButtonStyle}" />
    </Grid>

    <utu:TabBar Grid.Row="3" Style="{StaticResource BottomTabBarStyle}">
      <utu:TabBar.Items>
        <utu:TabBarItem Content="Home" IsSelected="True" />
        <utu:TabBarItem Content="Library" />
        <utu:TabBarItem Content="Sound" />
        <utu:TabBarItem Content="Settings" />
      </utu:TabBar.Items>
    </utu:TabBar>
  </Grid>
</Page>
